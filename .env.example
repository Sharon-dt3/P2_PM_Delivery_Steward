# Where an APPROVED morning brief goes. Safe by default: nothing is posted.

# mock (default) = P1's log-only publisher, writes to the file below.
# power_automate = P1's real publisher, posts through the Power Automate flow.
TEAMS_PUBLISHER_MODE=mock
TEAMS_PUBLISHER_LOG_PATH=data/outbound_log.jsonl

# Only used when TEAMS_PUBLISHER_MODE=power_automate.
POWER_AUTOMATE_FLOW_URL=

# Who may approve or reject a proposal (comma-separated ids). Empty means nobody:
# nothing can be approved, so nothing is ever sent.
PM_APPROVER_IDS=

# Unattended mode. Off unless exactly 1. When on, the system approves a morning
# brief itself -- recorded as "system:auto-approve", never as a person -- but only
# if grounding cut nothing from it (anything else waits for a person), and the
# channel's allowlist still applies to a real publisher.
PM_AUTO_APPROVE=0
# 1 (default): a person must have approved one brief for the channel first, so the
# first post to a channel is never unattended. Set to exactly 0 to drop that rule.
PM_AUTO_APPROVE_REQUIRES_FIRST_HUMAN=1

# Optional: which approver the dashboard preselects (must be one of PM_APPROVER_IDS).
# PM_DASHBOARD_USER=

# The dashboard's read-only P1 tab reads P1's database. Default: ../P3_Agents/data/p1_live.db
# P1_DB_PATH=

# Optional Supabase mirror of data/pm.db for viewing (see docs/viewing_the_database.md).
# The URL is a credential. Run scripts/sync_to_supabase.py by hand, or set
# PM_SUPABASE_MIRROR to exactly 1 to refresh it after every job and approval.
SUPABASE_DB_URL=
PM_SUPABASE_MIRROR=0
# The Postgres schema it writes into. Never "public" (that is P1's mirror).
PM_SUPABASE_SCHEMA=p2

# The risk log (risk_log/README.md). When exactly 1, each morning job first pulls the
# delivery lead's edits from the lead-facing table (Supabase p2.risk_log) so the brief
# reflects them. It never stops the brief: if the table is unreachable or the two sides
# conflict, the brief is built from the committed repo copy. Needs SUPABASE_DB_URL.
PM_RISK_LOG_SYNC=0

# PM-16: when 1, the morning job also proposes a risk-log entry for each current blocker missing from
# the risk log (proposals only: nothing is written to the log until a person approves one).
PM_RISK_DETECTION=0

# PM-19: how old (in days) a blocker must be before it is proposed as a risk. The value lives in
# config/risk_promotion.yaml; set this only to override it. A blocker must be OLDER than it.
# PM_RISK_PROMOTION_THRESHOLD_DAYS=2
# PM_RISK_PROMOTION_CONFIG=config/risk_promotion.yaml

# Claude on AWS Bedrock (blocked until the account's Marketplace subscription is done: run
# scripts/check_bedrock.py). Until then, leave these commented out and P2 falls back to local Ollama.
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-2
# BEDROCK_MODEL_ID=arn:aws:bedrock:us-east-2:<account-id>:inference-profile/<model-id>
# AWS_ACCESS_KEY_ID=...        # put keys in .env by hand; never paste them into chat or commit them
# AWS_SECRET_ACCESS_KEY=...

# PM-24: commitment follow-up. When 1, the morning job also reads P1's recent channel outcome records into the commitment
# store and follows up open commitments: a reminder before the due date, an overdue record, an escalation to the lead
# beyond a threshold. The first reminder to a person and the first escalation about a person wait for a person's approval.
# Off by default: it messages people. See docs/commitments.md and docs/shared_nudge_cap.md.
PM_COMMITMENT_FOLLOWUP=0
# How many days before the due date to remind (default 1), the lead (default: P1's channel_owner_id), how many days overdue
# is "beyond" (default: P1's escalation_threshold_days) and the shared per-person per-day cap (default: P1's nudge_cap_per_day).
# PM_COMMITMENT_NUDGE_DAYS_BEFORE=1
# PM_LEAD_ID=
# PM_COMMITMENT_ESCALATION_DAYS=3
# PM_NUDGE_CAP_PER_PERSON_PER_DAY=1
# Where P1's nudge ledger is (read-only, for the shared cap) and where P1 writes its outcome records.
# P1_DB_PATH=../P3_Agents/data/p1_live.db
# PM_OUTCOMES_DIR=../P3_Agents/outcomes
# PM_OUTCOMES_DAYS_BACK=7

# --- Copilot Studio / Power Automate connector (PM-28): uv run uvicorn pm.api.copilot_studio_api:app ---
# The shared secret the Power Platform connection sends as X-API-Key. If it is not set the API refuses every action endpoint.
# PM_COPILOT_API_KEY=a-long-random-value
# Which database the API reads and decides in (default data/pm.db). The approvers are PM_APPROVER_IDS, as for the command line.
# PM_DB_PATH=data/pm.db

# Where a NEW tracker item goes when approving a tracker batch and no sprint covers the day it was reported (an item needs a sprint).
# Name the sprint deliberately, e.g. sprint-13; the agent never picks one. Unset: such items are skipped and the audit says why.
PM_TRACKER_DEFAULT_SPRINT=

# The channel briefs: a morning brief and an end-of-day summary for REAL Teams channels, built only from P1's real record of what the team
# said (docs/channel_brief.md). Comma-separated P1 channel names or ids, all on P1's allowlist. scripts/run_scheduler.py schedules them
# (and then NOT the seeded sample project, unless --with-sample-project). Nothing is posted until a person approves each one.
PM_CHANNEL_BRIEFS=
# Where P1's outcome records are read from (default: outcomes/ in the P1 repo) and how many lines each section shows (default 5).
# PM_OUTCOMES_DIR=
# PM_CHANNEL_BRIEF_LINES=5
# An optional prefix on every channel brief post, e.g. "[agent] ".
PM_CHANNEL_BRIEF_LABEL=

# Opt-in: show a channel's day of real git commits in its brief (read-only). Channels split by ";", a channel's repositories by ",".
# PM_CHANNEL_REPOS=p1-agent-test=/path/to/P2_PM_Delivery_Steward,/path/to/P3_Agents

# PM-29 weekly report: an item created more than this many days after its sprint started counts as "added after planning" (default 2).
# PM_SCOPE_GRACE_DAYS=2
