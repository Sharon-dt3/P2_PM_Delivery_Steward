# Where an APPROVED morning brief goes. Safe by default: nothing is posted.

# mock (default) = P1's log-only publisher, writes to the file below.
# power_automate = P1's real publisher, posts through the Power Automate flow.
TEAMS_PUBLISHER_MODE=mock
TEAMS_PUBLISHER_LOG_PATH=data/outbound_log.jsonl

# Only used when TEAMS_PUBLISHER_MODE=power_automate.
POWER_AUTOMATE_FLOW_URL=

# Who may approve or reject a proposal (comma-separated ids). Empty means nobody:
# nothing can be approved, so nothing is ever sent.
PM_APPROVER_IDS=

# Unattended mode. Off unless exactly 1. When on, the system approves a morning
# brief itself -- recorded as "system:auto-approve", never as a person -- but only
# if grounding cut nothing from it (anything else waits for a person), and the
# channel's allowlist still applies to a real publisher.
PM_AUTO_APPROVE=0
# 1 (default): a person must have approved one brief for the channel first, so the
# first post to a channel is never unattended. Set to exactly 0 to drop that rule.
PM_AUTO_APPROVE_REQUIRES_FIRST_HUMAN=1

# Optional: which approver the dashboard preselects (must be one of PM_APPROVER_IDS).
# PM_DASHBOARD_USER=

# The dashboard's read-only P1 tab reads P1's database. Default: ../P3_Agents/data/p1_live.db
# P1_DB_PATH=

# Optional Supabase mirror of data/pm.db for viewing (see docs/viewing_the_database.md).
# The URL is a credential. Run scripts/sync_to_supabase.py by hand, or set
# PM_SUPABASE_MIRROR to exactly 1 to refresh it after every job and approval.
SUPABASE_DB_URL=
PM_SUPABASE_MIRROR=0
# The Postgres schema it writes into. Never "public" (that is P1's mirror).
PM_SUPABASE_SCHEMA=p2

# The risk log (risk_log/README.md). When exactly 1, each morning job first pulls the
# delivery lead's edits from the lead-facing table (Supabase p2.risk_log) so the brief
# reflects them. It never stops the brief: if the table is unreachable or the two sides
# conflict, the brief is built from the committed repo copy. Needs SUPABASE_DB_URL.
PM_RISK_LOG_SYNC=0
